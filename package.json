{
  "name": "bytemotion",
  "version": "1.0.0",
  "description": "Muhammad's Remotion-based content studio for educational YouTube/IG/LinkedIn videos and infographics.",
  "repository": {},
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "dependencies": {
    "@code-hike/lighter": "1.0.3",
    "@excalidraw/excalidraw": "^0.18.1",
    "@iconify/react": "^6.0.2",
    "@remotion/cli": "4.0.527",
    "@remotion/google-fonts": "4.0.527",
    "@remotion/install-whisper-cpp": "^4.0.527",
    "@remotion/layout-utils": "4.0.527",
    "@remotion/lottie": "^4.0.527",
    "@remotion/paths": "^4.0.527",
    "@remotion/shapes": "^4.0.527",
    "@remotion/studio": "4.0.527",
    "codehike": "1.0.4",
    "framer-motion": "^13.4.2",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.47.0",
    "msedge-tts": "^2.0.7",
    "perfect-freehand": "^1.2.3",
    "polished": "4.3.1",
    "puppeteer": "^25.12.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.527",
    "roughjs": "^4.6.6",
    "twoslash-cdn": "0.3.1",
    "use-sound": "^5.0.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.527",
    "@types/react": "19.2.7",
    "@types/react-dom": "^19.3.0",
    "@types/web": "0.0.166",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "9.19.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3",
    "vite": "^8.3.0"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "tsc && eslint apps/remotion",
    "gen:sfx": "node library/scripts/shared/generate-sfx.mjs",
    "gen:voice": "node library/scripts/remotion/generate-voiceover.mjs",
    "check:diagrams": "node library/scripts/excalidraw/check-diagrams.mjs",
    "check:layout": "node library/scripts/remotion/check-layout.mjs",
    "check:assets": "node library/scripts/remotion/verify-assets.mjs",
    "render:diagrams": "node library/scripts/excalidraw/render-diagrams.mjs",
    "fetch:music": "node library/scripts/shared/fetch-music.mjs",
    "transcribe": "node library/scripts/shared/transcribe.mjs",
    "slides:dev": "vite --config apps/slides/vite.config.ts",
    "slides:build": "vite build --config apps/slides/vite.config.ts",
    "slides:preview": "vite preview --config apps/slides/vite.config.ts",
    "editor:dev": "vite --config apps/excalidraw-editor/vite.config.ts",
    "editor:build": "vite build --config apps/excalidraw-editor/vite.config.ts",
    "dev:all": "concurrently -n remotion,slides,editor -c blue,green,magenta \"npm run dev\" \"npm run slides:dev\" \"npm run editor:dev\""
  }
}