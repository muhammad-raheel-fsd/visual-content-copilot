      "opacity": 100, "seed": 70002, "roundness": null,
      "text": "KEY POINTS",
      "fontSize": 18, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 18 },
    { "id": "summary-b1", "type": "text", "x": 1040, "y": 432, "width": 360, "height": 20,
