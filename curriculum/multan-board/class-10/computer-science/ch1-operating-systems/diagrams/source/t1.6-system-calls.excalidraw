      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "seed": 70003, "roundness": null,
      "text": "1. Programs cannot use HW directly.",
      "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 14 },
    { "id": "summary-b2", "type": "text", "x": 1040, "y": 462, "width": 360, "height": 20,
