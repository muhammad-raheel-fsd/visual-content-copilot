      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "seed": 70006, "roundness": null,
      "text": "4. Result flows back to the program.",
      "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 14 },
    { "id": "summary-b5", "type": "text", "x": 1040, "y": 552, "width": 360, "height": 20,
