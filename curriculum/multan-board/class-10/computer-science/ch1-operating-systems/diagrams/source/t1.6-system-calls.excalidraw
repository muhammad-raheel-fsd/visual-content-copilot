      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "seed": 70005, "roundness": null,
      "text": "3. Kernel talks to hardware safely.",
      "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 14 },
    { "id": "summary-b4", "type": "text", "x": 1040, "y": 522, "width": 360, "height": 20,
