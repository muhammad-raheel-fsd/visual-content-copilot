      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "seed": 70008, "roundness": null,
      "text": "Safety: user code stays in user\nmode; kernel enters kernel mode.",
