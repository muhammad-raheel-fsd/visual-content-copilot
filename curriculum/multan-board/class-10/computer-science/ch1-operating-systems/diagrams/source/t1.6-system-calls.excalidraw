      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "seed": 70004, "roundness": null,
      "text": "2. They ask the kernel via syscalls.",
      "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 14 },
    { "id": "summary-b3", "type": "text", "x": 1040, "y": 492, "width": 360, "height": 20,
