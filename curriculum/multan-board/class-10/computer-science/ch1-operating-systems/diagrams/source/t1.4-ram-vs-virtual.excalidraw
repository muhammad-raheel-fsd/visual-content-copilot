      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "dashed", "roughness": 1,
      "opacity": 100, "seed": 50030, "roundness": null,
      "points": [[0,0],[20,0]] },
    { "id": "legend-3-t", "type": "text", "x": 90, "y": 662, "width": 320, "height": 16,
      "angle": 0, "strokeColor": "#e6edf3", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "seed": 50031, "roundness": null,
      "text": "Dashed  =  Virtual memory (borrowed)",
      "fontSize": 14, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 14 },

    { "id": "summary-box", "type": "rectangle", "x": 460, "y": 570, "width": 880, "height": 180,
      "angle": 0, "strokeColor": "#e6edf3", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 2, "strokeStyle": "solid", "roughness": 2,
      "opacity": 100, "seed": 60001, "roundness": {"type":3} },
    { "id": "summary-title", "type": "text", "x": 480, "y": 584, "width": 300, "height": 26,
      "angle": 0, "strokeColor": "#e6edf3", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "seed": 60002, "roundness": null,
      "text": "KEY POINTS",
      "fontSize": 20, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 18 },

    { "id": "sum-1", "type": "text", "x": 480, "y": 618, "width": 840, "height": 20,
      "angle": 0, "strokeColor": "#e6edf3", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "seed": 60010, "roundness": null,
      "text": "1. RAM is fast primary memory - holds active programs, but is erased when power off.",
      "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 14 },

    { "id": "sum-2", "type": "text", "x": 480, "y": 644, "width": 840, "height": 20,
      "angle": 0, "strokeColor": "#e6edf3", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "seed": 60011, "roundness": null,
      "text": "2. Storage (HDD, SSD, NVMe) is slower but permanent and much larger.",
      "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 14 },

    { "id": "sum-3", "type": "text", "x": 480, "y": 670, "width": 840, "height": 20,
      "angle": 0, "strokeColor": "#e6edf3", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "seed": 60012, "roundness": null,
      "text": "3. When RAM fills up, OS moves less-used data to a Virtual Memory area on storage.",
      "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 14 },

    { "id": "sum-4", "type": "text", "x": 480, "y": 696, "width": 840, "height": 20,
      "angle": 0, "strokeColor": "#e6edf3", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "seed": 60013, "roundness": null,
      "text": "4. This frees space in RAM so active programs keep running smoothly.",
      "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 14 },

    { "id": "sum-5", "type": "text", "x": 480, "y": 722, "width": 840, "height": 20,
      "angle": 0, "strokeColor": "#8b949e", "backgroundColor": "transparent",
      "fillStyle": "solid", "strokeWidth": 1, "strokeStyle": "solid", "roughness": 1,
      "opacity": 100, "seed": 60014, "roundness": null,
      "text": "5. Virtual memory is slower than real RAM - it is a helper, not a replacement.",
      "fontSize": 15, "fontFamily": 1, "textAlign": "left", "verticalAlign": "top", "baseline": 14 }
  ],
