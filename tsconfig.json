{
  "compilerOptions": {
    "target": "ES2021",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": ["ES2021"],
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noUnusedLocals": true
  },
  "include": ["apps/remotion/**/*"],
  "exclude": [
    "library",
    "remotion.config.ts",
    "apps/slides",
    "apps/excalidraw-editor",
    "content",
    "output",
    "node_modules"
  ]
}
